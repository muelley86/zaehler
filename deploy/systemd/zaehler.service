# systemd-Unit für die Zählerstand-App.
#
# Pfade nehmen an, dass die Anwendung unter /opt/zaehler installiert ist und
# der App-Benutzer "zaehler" heißt. Anpassen, falls anders deployed.
# Aktivierung: siehe deploy/lxc/README.md, Abschnitt 4.6.

[Unit]
Description=Zaehlerstand-App (FastAPI + Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zaehler
Group=zaehler
WorkingDirectory=/opt/zaehler/backend

# uv und pnpm liegen im User-lokalen .local/bin
Environment=PATH=/opt/zaehler/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
# Code-Verzeichnis ist zur Laufzeit read-only (ReadOnlyPaths, s. u.) — Python
# soll dort gar nicht erst __pycache__ schreiben wollen (der Versuch schlüge
# sonst nur harmlos fehl; .pyc werden beim Deploy erzeugt).
Environment=PYTHONDONTWRITEBYTECODE=1
# Lokale Zeitzone fuer Prozess-Logs. DB und API bleiben bewusst UTC; OS-weit
# (systemd-Timer/Backup, Dateizeitstempel) setzt der Installer zusaetzlich
# timedatectl set-timezone Europe/Berlin.
Environment=TZ=Europe/Berlin

# Standardpfad für die SQLite-Datenbank. Der Pfad wird durch meters.env
# überschrieben werden, falls die Datei existiert.
Environment=METERS_DATABASE_URL=sqlite:////opt/zaehler/data/meters.db

# Optionale Konfigurationsdatei (METERS_SECRET_KEY, METERS_COOKIE_SECURE, ...).
# Das führende '-' weist systemd an, das Fehlen NICHT als Fehler zu werten.
EnvironmentFile=-/opt/zaehler/data/meters.env

# Bind-Host und -Port kommen aus meters.env (METERS_BIND_HOST, METERS_BIND_PORT).
# Default: 0.0.0.0:8000 — direkter LAN-Zugriff.
# Sobald ein HTTPS-Reverse-Proxy davor steht, in meters.env auf 127.0.0.1 setzen.
# --no-sync: die venv wird bereits beim Deploy per `uv sync --frozen` erzeugt
# (zaehler.sh), daher beim Service-Start NICHT erneut synchronisieren. Harmlos
# (Deploy synct ohnehin) und Voraussetzung dafür, ReadWritePaths später auf
# data/ zu verengen (separater PR nach LXC-Verifikation, dass der Start ohne
# venv-Schreibzugriff durchläuft).
ExecStart=/opt/zaehler/.local/bin/uv run --no-sync python -m meters.server

Restart=on-failure
RestartSec=3

# --- Hardening (siehe systemd.exec(5)) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
# Härtung des Datei-Zugriffs. Ansatz: ALLES unter /opt/zaehler bleibt schreibbar
# (ReadWritePaths) — die App-Daten liegen je nach Deploy an mehreren Stellen
# (DB unter /opt/zaehler/data, Fotos+Restore-Staging unter /opt/zaehler/repo/data,
# Backups, uv-Cache). Statt diese Schreibpfade fehleranfällig aufzuzählen, machen
# wir gezielt nur Quellcode + venv read-only (ReadOnlyPaths): eine kompromittierte
# App kann so keinen Code/kein venv PERSISTENT verändern, ohne dass ein
# Daten-Schreibpfad riskiert wird. Zur Laufzeit wird der Code nur gelesen (static/
# ausgeliefert, venv importiert; Build/uv-sync/.pyc passieren zur Deploy-Zeit).
# ACHTUNG: nur am echten LXC verifizierbar — nach dem Deploy `systemctl restart
# zaehler` + `status`/Logs prüfen; dass ReadOnlyPaths einen Unterpfad eines
# ReadWritePaths-Baums read-only macht, vorab per `systemd-run --scope` testen.
ReadWritePaths=/opt/zaehler
ReadOnlyPaths=/opt/zaehler/repo/backend /opt/zaehler/repo/frontend
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=true
UMask=0027

[Install]
WantedBy=multi-user.target
