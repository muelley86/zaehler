# systemd-Unit für die Zählerstand-App.
#
# Pfade nehmen an, dass die Anwendung unter /opt/zaehler installiert ist und
# der App-Benutzer "zaehler" heißt. Anpassen, falls anders deployed.
# Aktivierung: siehe deploy/lxc/README.md, Abschnitt 4.6.

[Unit]
Description=Zaehlerstand-App (FastAPI + Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zaehler
Group=zaehler
WorkingDirectory=/opt/zaehler/backend

# uv und pnpm liegen im User-lokalen .local/bin
Environment=PATH=/opt/zaehler/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
# Lokale Zeitzone fuer Prozess-Logs. DB und API bleiben bewusst UTC; OS-weit
# (systemd-Timer/Backup, Dateizeitstempel) setzt der Installer zusaetzlich
# timedatectl set-timezone Europe/Berlin.
Environment=TZ=Europe/Berlin

# Standardpfad für die SQLite-Datenbank. Der Pfad wird durch meters.env
# überschrieben werden, falls die Datei existiert.
Environment=METERS_DATABASE_URL=sqlite:////opt/zaehler/data/meters.db

# Optionale Konfigurationsdatei (METERS_SECRET_KEY, METERS_COOKIE_SECURE, ...).
# Das führende '-' weist systemd an, das Fehlen NICHT als Fehler zu werten.
EnvironmentFile=-/opt/zaehler/data/meters.env

# Bind-Host und -Port kommen aus meters.env (METERS_BIND_HOST, METERS_BIND_PORT).
# Default: 0.0.0.0:8000 — direkter LAN-Zugriff.
# Sobald ein HTTPS-Reverse-Proxy davor steht, in meters.env auf 127.0.0.1 setzen.
# --no-sync: die venv wird bereits beim Deploy per `uv sync --frozen` erzeugt
# (zaehler.sh), daher beim Service-Start NICHT erneut synchronisieren — sonst
# müsste `backend/.venv` schreibbar sein und ReadWritePaths könnte nicht auf
# data/ verengt werden.
ExecStart=/opt/zaehler/.local/bin/uv run --no-sync python -m meters.server

Restart=on-failure
RestartSec=3

# --- Hardening (siehe systemd.exec(5)) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
# Zur Laufzeit braucht der Dienst nur data/ (SQLite-DB, WAL, Fotos) und den
# uv-Cache schreibbar. Quellcode und venv (backend/.venv) bleiben read-only —
# eine kompromittierte App kann so keinen Code/kein venv persistent verändern.
# (venv wird beim Deploy via `uv sync --frozen` erzeugt, Start läuft mit
# `--no-sync`; Frontend-Build schreibt static/ ebenfalls nur zur Deploy-Zeit.)
# data/ existiert immer (DB); .cache mit '-' = nur einbinden, wenn vorhanden
# (verhindert Start-Fehler, falls der uv-Cache noch nicht angelegt wurde).
# ACHTUNG: nur auf dem echten LXC verifizierbar — nach dem Deploy einmal
# `systemctl restart zaehler` + `systemctl status`/Logs prüfen. Startet uv
# wegen fehlendem Schreibpfad nicht, auf `/opt/zaehler` zurücksetzen.
ReadWritePaths=/opt/zaehler/data -/opt/zaehler/.cache
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=true
UMask=0027

[Install]
WantedBy=multi-user.target
